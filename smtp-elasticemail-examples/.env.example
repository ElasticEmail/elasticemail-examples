# SMTP credentials from the Elastic Email dashboard: Settings > SMTP > Create SMTP Credentials.
# The password is shown once. It is not your API key.
ELASTICEMAIL_SMTP_HOST=smtp.elasticemail.com
ELASTICEMAIL_SMTP_PORT=2525
ELASTICEMAIL_SMTP_USERNAME=you@yourdomain.com
ELASTICEMAIL_SMTP_PASSWORD=your_smtp_password

# EMAIL_FROM must belong to a domain verified on the account.
EMAIL_FROM=Acme <hello@yourdomain.com>
EMAIL_TO=you@yourdomain.com
