# Used by `vercel dev`. Copy to .env (gitignored) or pull with `vercel env pull`.
ELASTICEMAIL_API_KEY=your_api_key
EMAIL_FROM=Acme <hello@yourdomain.com>
EMAIL_TO=you@yourdomain.com
ELASTICEMAIL_WEBHOOK_TOKEN=change_me
# Signing secret returned once when the webhook is created with EnableSigning; leave empty to use ELASTICEMAIL_WEBHOOK_TOKEN
ELASTICEMAIL_WEBHOOK_SECRET=
