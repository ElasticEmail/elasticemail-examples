# Copy to .env. Firebase loads it into the functions at deploy time and in the emulator.
# Do not put ELASTICEMAIL_API_KEY or ELASTICEMAIL_WEBHOOK_TOKEN here: they are secrets
# (see .secret.local.example), and deploy fails if a name is both a secret and an env var.
EMAIL_FROM=Acme <hello@yourdomain.com>
EMAIL_TO=you@yourdomain.com
