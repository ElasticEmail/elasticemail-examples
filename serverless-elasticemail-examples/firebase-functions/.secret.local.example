# Copy to .secret.local for the emulator only. In production these come from
# `firebase functions:secrets:set <NAME>` (Cloud Secret Manager).
ELASTICEMAIL_API_KEY=your_api_key
ELASTICEMAIL_WEBHOOK_TOKEN=change_me
# Signing secret returned once when the webhook is created with EnableSigning; leave empty (or "none") to use ELASTICEMAIL_WEBHOOK_TOKEN
ELASTICEMAIL_WEBHOOK_SECRET=
