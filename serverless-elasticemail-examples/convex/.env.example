# Convex functions do not read this file. Set each value on the deployment instead:
#   npx convex env set ELASTICEMAIL_API_KEY your_api_key
# or all at once:
#   npx convex env set --from-file .env
# `npx convex dev` writes CONVEX_DEPLOYMENT to .env.local; keep these values out of that file.
ELASTICEMAIL_API_KEY=your_api_key
EMAIL_FROM=Acme <hello@yourdomain.com>
EMAIL_TO=you@yourdomain.com
ELASTICEMAIL_WEBHOOK_TOKEN=change_me
