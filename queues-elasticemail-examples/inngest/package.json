{
  "name": "inngest-elasticemail-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "enqueue": "tsx src/enqueue.ts",
    "fanout": "tsx src/enqueue.ts --fanout",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@elasticemail/elasticemail-client-ts-axios": "^4.2.0",
    "dotenv": "^16.4.0",
    "inngest": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
