# Elastic Email API key: https://app.elasticemail.com/marketing/settings/new/manage-api
ELASTICEMAIL_API_KEY=your_api_key

# Verified sender (the domain or address must be verified in Elastic Email)
EMAIL_FROM=Acme <hello@yourdomain.com>
# Test recipient. Elastic Email has no sandbox addresses, so send to yourself.
EMAIL_TO=you@yourdomain.com
CONTACT_EMAIL=team@yourdomain.com

# Shared secret appended to webhook and inbound URLs as ?token=...
# Elastic Email does not sign webhooks, so the handlers verify this token instead.
ELASTICEMAIL_WEBHOOK_TOKEN=change_me

# Contact list used by the contacts and double opt-in examples
ELASTICEMAIL_LIST_NAME=Newsletter

# Template used by the template example (created on first run if missing)
ELASTICEMAIL_TEMPLATE_NAME=welcome-example

# Public base URL of this app, used to build confirm links and webhook URLs
PUBLIC_URL=http://localhost:3000

# Domain used by the domains and inbound examples
SENDING_DOMAIN=yourdomain.com

# Optional redirect after double opt-in confirmation
CONFIRM_REDIRECT_URL=
