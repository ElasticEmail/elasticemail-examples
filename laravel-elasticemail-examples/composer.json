{
    "name": "elasticemail/laravel-elasticemail-examples",
    "description": "Elastic Email examples with Laravel",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "~8.3.36 || ~8.4.27 || ^8.5.12",
        "laravel/framework": "^13.0",
        "elasticemail/elasticemail-php": "^4.4"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
