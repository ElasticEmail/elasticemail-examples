ELASTICEMAIL_API_KEY=your_api_key
EMAIL_FROM=Acme <hello@yourdomain.com>
EMAIL_TO=you@yourdomain.com
# Comma-separated domains the agent may email. Defaults to the domain of EMAIL_TO.
EMAIL_ALLOWED_DOMAINS=yourdomain.com
OPENAI_API_KEY=your_openai_api_key
# Optional. Leave empty to use the Agents SDK default model.
OPENAI_MODEL=
